# Copia este archivo a .env.local y ajusta lo que necesites.
# Ninguna de estas variables es obligatoria: todas tienen valor por defecto.

# Puerto del servidor de desarrollo y de `vite preview` (por defecto 8443).
PORT=8443

# Interruptor ÚNICO de indexación (robots.txt y <meta name="robots">).
# Por defecto el sitio NO es indexable. Se cambia en la Fase 6, no antes.
# SITE_INDEXABLE=true
